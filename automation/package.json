{
  "name": "integration-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:edge": "playwright test --project=edge",
    "parallel": "node scripts/run-parallel.ts",
    "sf:run-now": "node scripts/run-now.ts",
    "test:email-opened": "bash scripts/run-email-opened.sh",
    "test:email-bounced": "bash scripts/run-email-bounced.sh",
    "smoke:company-created": "bash scripts/run-company-created-smoke.sh",
    "test:link-clicked": "bash scripts/run-link-clicked.sh",
    "smoke:unsubscribed": "bash scripts/run-unsubscribed-smoke.sh",
    "smoke:salesforce-email-sent": "bash scripts/run-salesforce-email-sent-smoke.sh",
    "smoke:salesforce-outcome-updated": "bash scripts/run-salesforce-outcome-updated-smoke.sh",
    "smoke:pipedrive-email-sent": "bash scripts/run-pipedrive-email-sent-smoke.sh",
    "smoke:pipedrive-outcome-updated": "bash scripts/run-pipedrive-outcome-updated-smoke.sh",
    "smoke:pipedrive-link-clicked": "bash scripts/run-pipedrive-link-clicked-smoke.sh",
    "smoke:pipedrive-email-bounced": "bash scripts/run-pipedrive-email-bounced-smoke.sh",
    "smoke:pipedrive-email-opened": "bash scripts/run-pipedrive-email-opened-smoke.sh",
    "smoke:pipedrive-unsubscribed": "bash scripts/run-pipedrive-unsubscribed-smoke.sh",
    "smoke:pipedrive-reply-received": "bash scripts/run-pipedrive-reply-received-smoke.sh",
    "smoke:zoho-email-opened": "bash scripts/run-zoho-email-opened-smoke.sh",
    "smoke:zoho-email-bounced": "bash scripts/run-zoho-email-bounced-smoke.sh",
    "test:pipedrive-email-opened": "bash scripts/run-pipedrive-email-opened.sh",
    "test:pipedrive-outcome-updated": "bash scripts/run-pipedrive-outcome-updated.sh",
    "test:unsubscribed": "bash scripts/run-unsubscribed.sh",
    "test:outcome-updated": "bash scripts/run-prospect-outcome-updated.sh",
    "test:reply-all": "bash scripts/run-reply-received-all-activities.sh",
    "outcome-updated:failures": "node scripts/outcome-failures.ts",
    "test:unsubscribed-lite": "bash scripts/run-unsubscribed-lite.sh",
    "login:saleshandy": "node scripts/login.ts saleshandy chromium",
    "login:saleshandy:edge": "node scripts/login.ts saleshandy edge",
    "login:hubspot": "node scripts/login.ts hubspot chromium",
    "login:hubspot:edge": "node scripts/login.ts hubspot edge",
    "login:salesforce": "node scripts/login.ts salesforce chromium",
    "login:pipedrive": "node scripts/login.ts pipedrive chromium",
    "login:zoho": "node scripts/login.ts zoho chromium",
    "test:zoho-reply-received": "TEST_DATA_ONLY=zoho/reply-received REPORTS_DIR=reports/zoho-reply-received xvfb-run -a playwright test --project=chromium tests/zoho/reply-received.spec.ts --workers=1 --output=test-results-zoho-reply-received",
    "test:zoho-email-sent": "TEST_DATA_ONLY=zoho/email-sent REPORTS_DIR=reports/zoho-email-sent xvfb-run -a playwright test --project=chromium tests/zoho/email-sent.spec.ts --workers=1 --output=test-results-zoho-email-sent",
    "data:zoho-email-sent": "node scripts/make-zoho-email-sent-data.ts",
    "data:zoho-link-clicked": "node scripts/make-zoho-link-clicked-data.ts",
    "setup:zoho-link-clicked-sequence": "SETUP_SEQUENCE=1 REPORT_OPEN=never playwright test --project=chromium tests/setup/zoho-link-clicked-sequence.spec.ts --workers=1",
    "test:zoho-link-clicked": "KEEP_OTHER_TRIGGERS=1 TEST_DATA_ONLY=zoho/link-clicked REPORTS_DIR=reports/zoho-link-clicked xvfb-run -a playwright test --project=chromium tests/zoho/link-clicked.spec.ts --workers=1 --output=test-results-zoho-link-clicked",
    "data:zoho-email-opened": "node scripts/make-zoho-email-opened-data.ts",
    "test:zoho-email-opened": "KEEP_OTHER_TRIGGERS=1 TEST_DATA_ONLY=zoho/email-opened REPORTS_DIR=reports/zoho-email-opened xvfb-run -a playwright test --project=chromium tests/zoho/email-opened.spec.ts --workers=1 --output=test-results-zoho-email-opened",
    "data:zoho-email-bounced": "node scripts/make-zoho-email-bounced-data.ts",
    "test:zoho-email-bounced": "KEEP_OTHER_TRIGGERS=1 TEST_DATA_ONLY=zoho/email-bounced REPORTS_DIR=reports/zoho-email-bounced xvfb-run -a playwright test --project=chromium tests/zoho/email-bounced.spec.ts --workers=1 --output=test-results-zoho-email-bounced",
    "data:zoho-prospect-unsubscribed": "node scripts/make-zoho-prospect-unsubscribed-data.ts",
    "test:zoho-prospect-unsubscribed": "KEEP_OTHER_TRIGGERS=1 TEST_DATA_ONLY=zoho/prospect-unsubscribed REPORTS_DIR=reports/zoho-prospect-unsubscribed xvfb-run -a playwright test --project=chromium tests/zoho/prospect-unsubscribed.spec.ts --workers=1 --output=test-results-zoho-prospect-unsubscribed",
    "data:zoho-conversation-category-updated": "node scripts/make-zoho-conversation-category-updated-data.ts",
    "test:zoho-conversation-category-updated": "KEEP_OTHER_TRIGGERS=1 TEST_DATA_ONLY=zoho/conversation-category-updated REPORTS_DIR=reports/zoho-conversation-category-updated xvfb-run -a playwright test --project=chromium tests/zoho/conversation-category-updated.spec.ts --workers=1 --output=test-results-zoho-conversation-category-updated",
    "not-emailsent-zoho": "KEEP_TEST_DATA=1 SETUP_ACCOUNT=notemailsentzoho playwright test --project=chromium tests/setup/zoho-field-mapping.spec.ts --workers=1",
    "login:salesforce:fresh": "node scripts/login-salesforce-fresh.ts",
    "login:salesforce:auto": "node --env-file-if-exists=.env scripts/login-salesforce-auto.ts",
    "prospect:delete": "node scripts/delete-prospect.ts",
    "hubspot:delete-contact": "node scripts/delete-hubspot-contact.ts",
    "data:generate": "node scripts/generate-data.ts",
    "data:check": "node scripts/check-data.ts",
    "data:salesforce-side": "node scripts/make-salesforce-side-data.ts",
    "typecheck": "tsc --noEmit",
    "report": "node scripts/render-report.ts",
    "mcp:open": "node scripts/open-mcp-browser.ts",
    "jira": "node --env-file-if-exists=.env jira/server/server.ts",
    "jira:check": "node --env-file-if-exists=.env jira/server/server.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
