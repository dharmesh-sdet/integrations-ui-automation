# Key names only. Copy to .env and fill values locally. Never commit .env.
# Wed 7 needs no keys: base URLs are in src/config/environments.ts and
# logins are saved sessions in auth/ (no HubSpot or Saleshandy password is
# read from env; never put one in this file).
# API and Jira keys are added in the phase that needs them (Thu 8, Mon 12).

# Jira (local server, npm run jira): your Atlassian login email and an API token
# from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# HubSpot test account login (placeholders, fill in .env only, never here).
# Nothing reads these yet: scripts/login.ts uses a saved session in auth/.
HUBSPOT_USERNAME=
HUBSPOT_PASSWORD=

# Salesforce test-org login (shared org saleshandy-dev-ed). Used only when the
# Salesforce "Re-connect" popup asks for a login (src/flows/salesforce-connection.ts)
# and by npm run login:salesforce:auto. Read in a separate process, never in a test,
# so no report or trace records it. If Salesforce asks for an SMS code, the script
# opens a window and waits up to 5 minutes for QA to type it.
SALESFORCE_SANDBOX_USERNAME=
SALESFORCE_SANDBOX_PASSWORD=
