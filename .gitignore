# Dependencies
node_modules/

# Secrets and logged-in sessions (cookies, tokens, browser profiles)
.env
.env.*
!.env.example
automation/auth/*
!automation/auth/.gitkeep

# Run output (regenerated by each run)
automation/reports/*
!automation/reports/.gitkeep
test-results/
playwright-report/

# Playwright MCP scratch
.playwright-mcp/

# OS / editor
.DS_Store
*.log

# Machine-specific MCP config (absolute paths); add to git when pushing
automation/.mcp.json
/.mcp.json

# Editor config (terminal profiles and tasks are personal)
.vscode/

# Per-run Playwright output folders (traces, videos; may hold session data)
automation/test-results-*/
